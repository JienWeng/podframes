{
  "name": "@podframes/core",
  "version": "0.1.0",
  "description": "Two-host AI podcast videos with local Codex, Fish Audio, P-Video, LTX, HeyGen, and HyperFrames.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./shared": {
      "types": "./src/shared.ts",
      "default": "./src/shared.ts"
    },
    "./timeline": {
      "types": "./src/compose/trim.ts",
      "default": "./src/compose/trim.ts"
    },
    "./captions": "./src/compose/captions.ts",
    "./script-import": "./src/script-import.ts",
    "./package.json": "./package.json"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Jellypod-Inc/podframes"
  },
  "homepage": "https://github.com/Jellypod-Inc/podframes",
  "bugs": "https://github.com/Jellypod-Inc/podframes/issues",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/compose/*.test.ts src/stages/*.test.ts src/*.test.ts src/clients/*.test.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.0",
    "dotenv": "^16.4.7",
    "hyperframes": "^0.6.110",
    "replicate": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
